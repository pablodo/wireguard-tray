post_install() {
cat <<EOF
=================================================
WireGuard Tray installed successfully!

Quick setup:

    Setup sudoers for passwordless operation:
    sudo wireguard-tray --sudo-setup

    Run the application:
    wireguard-tray

    Enable autostart:
    wireguard-tray --autostart

    Disable autostart:
    wireguard-tray --disable-autostart

Additional commands:
wireguard-tray --help # Show all available commands
wireguard-tray --set wg0 # Set default interface
wireguard-tray --up wg0 # Connect to interface wg0
wireguard-tray --down # Disconnect from current interface

Important: Place WireGuard configuration files in /etc/wireguard/
(e.g., wg0.conf, wg1.conf, etc.)

=================================================
EOF
}
